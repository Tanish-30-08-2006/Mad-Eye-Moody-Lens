# Copy to .env and fill the pins printed by `python -m scripts.download_models`.
# Every variable is documented in backend/app/core/config.py and design doc Section 11.

MML_ENV=production
MML_LOG_LEVEL=INFO
MML_DETECTOR_BACKEND=real          # "stub" runs the whole stack without model weights

# --- models (CPU only: no GPU for demo or deployment)
MML_IMAGE_MODEL_ID=Organika/sdxl-detector
MML_IMAGE_MODEL_REVISION=           # paste the commit hash from download_models
MML_FACE_MODEL_ID=Xicor9/efficientnet-b0-ffpp-c23
MML_FACE_MODEL_SHA256=              # paste the checksum from download_models
MML_FACE_MODEL_NORMALIZE=false      # set from the benchmark (higher ROC-AUC wins)
MML_AUDIO_MODEL_ID=MelodyMachine/Deepfake-audio-detection-V2
MML_AUDIO_MODEL_REVISION=
MML_DEVICE=cpu
MML_TORCH_THREADS=2

# --- verdicts and limits (must match frontend/src/config/models.ts)
MML_BAND_LOW=0.35
MML_BAND_HIGH=0.65
MML_AGGREGATION=max
MML_MAX_IMAGE_MB=10
MML_MAX_AUDIO_MB=25
MML_MAX_VIDEO_MB=100

# --- explanations, retention, queueing
MML_EXPLAIN_ENABLED=true
MML_EXPLAIN_MAX_FRAMES=3
MML_RESULT_RETENTION_DAYS=7
MML_JOB_TTL_H=24
MML_SYNC_TIMEOUT_S=30
MML_MAX_QUEUE_DEPTH=50

# --- infrastructure (service names from docker-compose.prod.yml)
POSTGRES_PASSWORD=change-me
MML_DATABASE_URL=postgresql+psycopg://mml:change-me@postgres:5432/mml
MML_REDIS_URL=redis://redis:6379/0
MML_STORAGE_BACKEND=local
MML_STORAGE_ROOT=/data/uploads
MML_CLIENT_HASH_SECRET=change-me-to-a-long-random-string
MML_CORS_ORIGINS=[]                 # same origin behind nginx: no CORS needed
