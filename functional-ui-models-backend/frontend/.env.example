# Backend base URL. Leave empty to call relative /api/v1/... paths: the Vite dev
# server (vite.config.ts) and nginx in Docker both forward them to FastAPI.
# Set http://localhost:8000 only to bypass the proxy (then the backend needs
# MML_CORS_ORIGINS=["http://localhost:5173"]).
VITE_API_URL=

# Verdict bands — keep in sync with backend MML_BAND_LOW / MML_BAND_HIGH.
# The backend decides the verdict; these only draw the band markers in the UI.
VITE_BAND_LOW=0.35
VITE_BAND_HIGH=0.65
