# Local development without Docker (copy to backend/.env).
# Every backend process started from the backend/ folder (API, worker, alembic)
# reads this file automatically. Paths are relative to backend/.

MML_ENV=development                 # coloured logs, /docs enabled
MML_DETECTOR_BACKEND=real           # "stub" = fixed scores, no model download (fast UI work)

# Models download on first worker start into ~/.cache (a few minutes, once).
MML_DEVICE=cpu
MML_TORCH_THREADS=2

# One worker serves every queue on the 8 GB laptop (models loaded once, ~2.5 GB).
MML_WORKER_QUEUES=inference.fast,inference.video,maintenance

# No Postgres or MinIO needed locally: SQLite file + a local folder.
MML_DATABASE_URL=sqlite:///./data/mml.db
MML_REDIS_URL=redis://localhost:6379/0
MML_STORAGE_BACKEND=local
MML_STORAGE_ROOT=./data/uploads
MML_TMP_DIR=./data/tmp

# The Vite dev server proxies /api to :8000, so CORS is not needed; this line only
# matters if you point the frontend straight at http://localhost:8000.
MML_CORS_ORIGINS=["http://localhost:5173"]

# Video jobs share the single worker, so give image/audio a little more time to wait.
MML_SYNC_TIMEOUT_S=60
