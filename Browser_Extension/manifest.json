{
  "manifest_version": 3,
  "name": "Mad Eye Moody Lens",
  "version": "2.0.2",
  "description": "Real-time image, video, and audio deepfake detection with configurable cloud and local AI providers.",
  "permissions": [
    "storage",
    "contextMenus",
    "sidePanel",
    "scripting",
    "tabs",
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "https://api.bitmind.ai/*",
    "https://*.zerotrue.app/*",
    "https://zerotrue.app/*",
    "https://applications-temp-videos-us-east-1.s3.us-east-1.amazonaws.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "backend/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "frontend/popup.html",
    "default_title": "Mad Eye Moody Lens"
  },
  "side_panel": {
    "default_path": "frontend/sidepanel.html"
  },
  "options_page": "frontend/options.html"
}
