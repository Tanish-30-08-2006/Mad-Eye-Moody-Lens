# ==========================================
# Telegram Bot Configuration
# ==========================================
# Get your token from @BotFather on Telegram:
TELEGRAM_BOT_TOKEN="YOUT_TOKEN_HERE"

# API URL that the bot will communicate with:
DETECTOR_API_URL="http://localhost:8000/predict"
DETECTOR_HEALTH_URL="http://localhost:8000/health"

# ==========================================
# Detector API Service Configuration
# ==========================================
# Backend options:
#   "hf"        -> Uses Hugging Face pretrained model (Organika/sdxl-detector)
#   "custom_pt" -> Uses your custom trained CIFAKE checkpoint file
#   "stub"      -> Returns simulated predictions (for testing without downloading weights)
MODEL_BACKEND="hf"

# Hugging Face model identifier (used if MODEL_BACKEND="hf")
HF_MODEL_NAME="Organika/sdxl-detector"

# Path to custom PyTorch checkpoint (used if MODEL_BACKEND="custom_pt")
CHECKPOINT_PATH="cifake_resnet18.pt"

# Device: "cpu" or "cuda"
DEVICE="cpu"

# API Port
PORT=8000

