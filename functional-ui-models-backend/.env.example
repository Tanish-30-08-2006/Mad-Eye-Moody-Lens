# Copy to .env and fill the pins printed by `python -m scripts.download_models`.
# Keep comments for EMPTY values on their own line: compose reads `KEY=   # note` as KEY="# note".
# Every variable is documented in backend/app/core/config.py and design doc Section 11.

MML_ENV=production
MML_LOG_LEVEL=INFO
MML_DETECTOR_BACKEND=real          # "stub" runs the whole stack without model weights

# --- models (CPU only: no GPU for demo or deployment)
MML_IMAGE_MODEL_ID=Organika/sdxl-detector
# paste the commit hash from download_models
MML_IMAGE_MODEL_REVISION=
MML_FACE_MODEL_ID=Xicor9/efficientnet-b0-ffpp-c23
# paste the checksum from download_models
MML_FACE_MODEL_SHA256=
MML_FACE_MODEL_NORMALIZE=false      # set from the benchmark (higher ROC-AUC wins)
MML_AUDIO_MODEL_ID=MelodyMachine/Deepfake-audio-detection-V2
MML_AUDIO_MODEL_REVISION=
MML_DEVICE=cpu
MML_TORCH_THREADS=2

# --- verdicts and limits (must match frontend/src/config/models.ts)
MML_BAND_LOW=0.35
MML_BAND_HIGH=0.65
MML_AGGREGATION=max
MML_MAX_IMAGE_MB=10
MML_MAX_AUDIO_MB=25
MML_MAX_VIDEO_MB=100

# --- explanations, retention, queueing
MML_EXPLAIN_ENABLED=true
MML_EXPLAIN_MAX_FRAMES=3
MML_RESULT_RETENTION_DAYS=7
MML_JOB_TTL_H=24
MML_SYNC_TIMEOUT_S=30
MML_MAX_QUEUE_DEPTH=50

# --- infrastructure (service names from docker-compose.prod.yml)
POSTGRES_PASSWORD=change-me
MML_DATABASE_URL=postgresql+psycopg://mml:change-me@postgres:5432/mml
MML_REDIS_URL=redis://redis:6379/0
MML_STORAGE_BACKEND=local
MML_STORAGE_ROOT=/data/uploads
MML_CLIENT_HASH_SECRET=change-me-to-a-long-random-string
MML_CORS_ORIGINS=[]                 # same origin behind nginx: no CORS needed

# --- client integrations (Chrome extension, Reddit extension, Telegram bot)
MML_BRAIN=host                      # Reddit API scans on the shared workers; never "stub" in production
MML_ALLOW_MOCK=false                # true lets the Reddit API return demo data (marked mock) with no workers
FEATURE_DETECT_URL=false            # Reddit tier-2 yt-dlp fallback; needs a pinned yt-dlp in the API image
# Extensions call the API from chrome-extension://<id>. Default: any extension id. Pin it in production:
# MML_CORS_ORIGIN_REGEX=^chrome-extension://abcdefghijklmnopabcdefghijklmnop$
MML_VIDEO_SILENCE_DBFS=-60          # a soundtrack quieter than this is not scored as speech
# JSON list of API keys with the higher rate limits (X-API-Key). Include MML_BOT_API_KEY.
MML_API_KEYS=[]

# --- Telegram bot (docker compose --profile telegram); see telegram-bot/README.md
TELEGRAM_BOT_TOKEN=
# a long random string, also listed in MML_API_KEYS
MML_BOT_API_KEY=
# comma-separated chat ids; empty = anyone
BOT_ALLOWED_CHAT_IDS=
