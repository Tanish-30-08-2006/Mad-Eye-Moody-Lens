# ──────────────────────────────────────────────
# Multimodal Deepfake Detection Studio — Backend
# ──────────────────────────────────────────────

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info

# CORS – restrict to your local frontend
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits
MAX_IMAGE_SIZE_MB=20
MAX_AUDIO_SIZE_MB=100
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_SEC=300
MAX_VIDEO_FRAMES=60

# Temporary file directory (leave blank to use system default)
TEMP_DIR=

# ──────────────────────────────────────────────
# Model configuration (fill in after you add
# the actual checkpoints – see README §12)
# ──────────────────────────────────────────────

# Set to "true" once the weights file exists and dependencies are installed.
AUDIO_MODEL_ENABLED=false
IMAGE_MODEL_ENABLED=false

# Absolute path to your SSL Anti-Spoofing checkpoint (.pth)
# SSL_ANTISPOOF_CHECKPOINT=

# Absolute path to your Hybrid Xception-ViT checkpoint
# HYBRID_VIT_CHECKPOINT=
