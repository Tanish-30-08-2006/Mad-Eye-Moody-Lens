{
  "manifest_version": 3,
  "name": "BitMind Video Deepfake Detector",
  "version": "1.0.0",
  "description": "Real-time AI deepfake video detector powered by BitMind. Hover over any web video or upload videos to verify authenticity.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "sidePanel",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://api.bitmind.ai/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "backend/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "css": [
        "frontend/overlay.css"
      ],
      "js": [
        "frontend/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "frontend/popup.html",
    "default_title": "BitMind Video Deepfake Detector",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "frontend/sidepanel.html"
  },
  "options_page": "frontend/options.html"
}
