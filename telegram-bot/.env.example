# Copy to .env (local run) or set in the root compose .env (docker compose --profile telegram).

# From @BotFather (/newbot). Treat it like a password. (BOT_TOKEN alias also supported.)
TELEGRAM_BOT_TOKEN=YOUR_TOKEN_HERE

# Scoring mode:
#   real    (default) - lightweight Pillow+NumPy forensic signal scorer (~100 MB RAM, Render free-tier safe)
#   backend           - forward media to MML_API_BASE_URL
#   stub              - explicit fixed placeholder scores (for UI testing only)
MODEL_MODE=real

# Mad-Eye Moody Lens API (used when MODEL_MODE=backend). (BACKEND_URL alias also supported.)
# Inside docker compose: http://api:8000/api/v1
# Local (./dev.sh api in functional-ui-models-backend): http://localhost:8000/api/v1
MML_API_BASE_URL=http://localhost:8000/api/v1

# Optional: a key listed in the API's MML_API_KEYS gets the higher per-client limits.
# Recommended, because every Telegram user reaches the API through this one bot.
MML_API_KEY=

# Per-user fairness inside the bot.
BOT_REQUESTS_PER_MIN=6
BOT_VIDEO_TIMEOUT_S=360
BOT_MAX_DOWNLOAD_MB=20
# Comma-separated chat ids allowed to use the bot; empty = everyone (use a list for the demo).
BOT_ALLOWED_CHAT_IDS=
